# ==============================================================================
# VoicePilot AI - Environment Configuration Template
# COPY THIS FILE TO .env IN YOUR LOCAL SETUP
# NEVER COMMIT REAL SECRETS, PASSWORDS, OR PRIVATE KEYS TO VERSION CONTROL
# ==============================================================================

NODE_ENV=development

# ------------------------------------------------------------------------------
# Backend API Configuration (@voicepilot/api)
# ------------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database Connections (Prisma ORM)
# Find these in your Supabase Dashboard -> Project Settings -> Database -> Connection string
# ------------------------------------------------------------------------------
# 1. DATABASE_URL: Transaction Mode (Connection Pooling / Supavisor via port 6543)
DATABASE_URL=postgres://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# 2. DIRECT_URL: Direct Connection (Session Mode via port 5432, used for Prisma Migrations)
DIRECT_URL=postgres://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------------------
# Supabase Project API & Auth Credentials
# Find these in Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder

# ------------------------------------------------------------------------------
# Frontend Web Client (@voicepilot/web)
# Vite exposes variables prefixed with VITE_ to the browser client
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=https://[PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# ------------------------------------------------------------------------------
# AI Telephony & Speech Engine (Reserved for future phases)
# ------------------------------------------------------------------------------
# TWILIO_ACCOUNT_SID=your-twilio-sid-placeholder
# TWILIO_AUTH_TOKEN=your-twilio-auth-placeholder
# DEEPGRAM_API_KEY=your-deepgram-api-key-placeholder
# ELEVENLABS_API_KEY=your-elevenlabs-api-key-placeholder
# OPENAI_API_KEY=your-openai-api-key-placeholder
